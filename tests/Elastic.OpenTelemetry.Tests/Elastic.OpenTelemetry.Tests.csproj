  <ItemGroup>
    <ProjectReference Include="..\..\src\Elastic.OpenTelemetry\Elastic.OpenTelemetry.csproj" />
    <ProjectReference Include="..\..\test-applications\WebApi\WebApi.csproj" />
  </ItemGroup>

</Project>

